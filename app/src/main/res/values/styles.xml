<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="JewelGrade.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/jg_black</item>
        <item name="backgroundTint">@color/jg_gold</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="JewelGrade.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/jg_gold</item>
        <item name="strokeColor">@color/jg_gold_dark</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="JewelGrade.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/jg_gold_light</item>
    </style>

    <style name="JewelGrade.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/jg_black_soft</item>
        <item name="boxStrokeColor">@color/jg_gold_dark</item>
        <item name="hintTextColor">@color/jg_text_secondary</item>
        <item name="android:textColorHint">@color/jg_text_secondary</item>
    </style>

    <style name="JewelGrade.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/jg_text_primary</item>
    </style>

    <style name="JewelGrade.CardButton" parent="Widget.Material3.Button">
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

</resources>