<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_black_gold"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="24dp">

        <!-- Back Button -->
        <LinearLayout
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_dashboard_tile"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹"
                android:textColor="@color/jg_gold"
                android:textSize="32sp" />

        </LinearLayout>

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings &amp; Preferences"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
            android:textColor="@color/jg_gold_light"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Theme Mode Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glassmorphism"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/themeModeSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Theme Mode"
                android:textColor="@color/jg_text_primary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Model Selection Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Model Selection"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/jg_gold_light"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:layout_marginTop="8dp" />

        <!-- Model Selection Button -->
        <LinearLayout
            android:id="@+id/modelSelectionButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_glassmorphism"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="YOLOv8 Model"
                android:textColor="@color/jg_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/modelSelectionValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textColor="@color/jg_gold"
                android:textStyle="bold"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/jg_gold"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- Use On-Device Model Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glassmorphism"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/useModelSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use On-Device Model"
                android:textColor="@color/jg_text_primary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Use Quantized Model Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glassmorphism"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="24dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/useQuantizedSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use Quantized Model"
                android:textColor="@color/jg_text_primary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Karat Preference Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preferences"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/jg_gold_light"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Karat Preference Button -->
        <LinearLayout
            android:id="@+id/karatPreferenceButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_glassmorphism"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Preferred Karat"
                android:textColor="@color/jg_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/karatPreferenceValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18K"
                android:textColor="@color/jg_gold"
                android:textStyle="bold"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/jg_gold"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- Feedback Sharing Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glassmorphism"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/feedbackShareSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Share Feedback (Anonymous)"
                android:textColor="@color/jg_text_primary"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
