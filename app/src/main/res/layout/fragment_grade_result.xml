<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_black_gold"
    android:padding="20dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_glassmorphism"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jewelry Analysis Report"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
            android:textColor="@color/jg_gold_light"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/previewImage"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_preview"
            android:scaleType="centerCrop" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toggleDetectionsButton"
            style="@style/JewelGrade.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Show Original" />

        <TextView
            android:id="@+id/totalScoreText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Visual Similarity Score: 0%"
            android:textColor="@color/jg_gold_light"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/overallScoreBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_overall_rounded" />

        <TextView
            android:id="@+id/tierBadgeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_badge_tier_d"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="Assessment: Low Similarity"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dashboard_tile"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Item Summary"
                android:textColor="@color/jg_gold"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/itemTypeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Detected item: Unknown"
                android:textColor="@color/jg_text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/materialText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:singleLine="false"
                android:text="Karat estimate: Unknown"
                android:textColor="@color/jg_text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/karatBasisText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Based on the photo"
                android:textColor="@color/jg_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/modelUsedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Scan mode: Standard"
                android:textColor="@color/jg_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/bandShortMessageText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/bg_dashboard_tile"
                android:text="Explanation"
                android:textColor="@color/jg_gold_light"
                android:textStyle="italic"
                android:textSize="13sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/weightInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/weight_input_hint"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/weightInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:textColor="@color/jg_text_primary"
                    android:textColorHint="@color/jg_text_secondary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/estimateValueButton"
                style="@style/JewelGrade.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/estimate_value_button" />

            <LinearLayout
                android:id="@+id/valueContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:background="@drawable/bg_dashboard_tile"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textScrapLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Scrap (mid)"
                            android:textColor="@color/jg_text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/textScrapValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textColor="@color/jg_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/valueInfoButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_circle_info"
                        android:contentDescription="More info"
                        android:src="@drawable/ic_info_outline_white_24dp"
                        android:scaleType="centerInside" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textResaleLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resale (mid)"
                        android:textColor="@color/jg_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/textResaleValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="-"
                        android:textColor="@color/jg_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/textPriceUpdated"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Price: --"
                        android:textColor="@color/jg_text_secondary"
                        android:textSize="12sp" />

                    <ImageButton
                        android:id="@+id/btnPriceRefresh"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_circle_info"
                        android:contentDescription="Refresh price"
                        android:src="@drawable/ic_refresh_24dp"
                        android:scaleType="centerInside" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="What This Means"
            android:textColor="@color/jg_gold"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/analysisText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_dashboard_tile"
            android:padding="10dp"
            android:textColor="@color/jg_text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tips to Improve the Photo"
            android:textColor="@color/jg_gold"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rescanSuggestionsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_dashboard_tile"
            android:padding="10dp"
            android:textColor="@color/jg_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/advancedMetricsButton"
            style="@style/JewelGrade.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Advanced Metrics" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addStampButton"
            style="@style/JewelGrade.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Add Karat Stamp Closeup" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/gradeAnotherButton"
            style="@style/JewelGrade.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Grade Another" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            style="@style/JewelGrade.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back" />

        <!-- Feedback intake -->
        <LinearLayout
            android:id="@+id/feedbackContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_dashboard_tile"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Was this result helpful?"
                android:textColor="@color/jg_gold"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/feedbackRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/feedbackCorrect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correct" />

                <RadioButton
                    android:id="@+id/feedbackIncorrect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Incorrect" />
            </RadioGroup>

            <EditText
                android:id="@+id/feedbackComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Optional comment"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:maxLines="4"
                android:backgroundTint="@color/jg_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/feedbackSendButton"
                style="@style/JewelGrade.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Send Feedback" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
