<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="top"
    android:padding="10dp"
    android:background="@drawable/bg_glassmorphism">

    <!-- Left Column: Image, Title -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:layout_marginEnd="8dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/imageThumb"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            android:contentDescription="History thumbnail"
            android:adjustViewBounds="true"
            android:background="@drawable/rounded_thumb"
            android:clipToOutline="true" />

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/jg_gold_light"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            android:gravity="center" />

    </LinearLayout>

    <!-- Middle Column: Gauge, Score, Grade, Date -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:layout_marginEnd="8dp"
        android:gravity="center_horizontal">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:padding="6dp"
            android:foregroundGravity="center"
            android:clipToPadding="false"
            android:paddingEnd="6dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/confidenceGauge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:indicatorSize="36dp"
                app:trackThickness="6dp"
                app:indicatorDirectionCircular="clockwise"
                app:indicatorInset="4dp" />

        </FrameLayout>
        <TextView
            android:id="@+id/textScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/jg_gold_light"
            android:layout_marginTop="6dp"
            android:textSize="12.6sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:singleLine="false"
            android:lineSpacingExtra="0dp"
            android:includeFontPadding="false"
            android:gravity="center" />

        <TextView
            android:id="@+id/textGrade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/jg_gold_light"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/textDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/jg_text_secondary"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="6dp"
            android:gravity="center" />

    </LinearLayout>

    <!-- Right Column: Price, Uplift, Badge (fixed width to allow larger donut) -->
    <LinearLayout
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginStart="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/textValueSaved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/jg_text_secondary"
                android:textSize="12sp"
                android:textStyle="normal"
                android:text="--" />

            <TextView
                android:id="@+id/textValueLive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/jg_gold_light"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="-" />

        </LinearLayout>

        <TextView
            android:id="@+id/textValueUplift"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#26D07C"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text=""
            android:layout_marginTop="4dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/textBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_badge_tier_d"
            android:paddingStart="6dp"
            android:paddingTop="3dp"
            android:paddingEnd="6dp"
            android:paddingBottom="3dp"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>