<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_black_gold"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Account"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
            android:textColor="@color/jg_gold_light"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Profile Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glassmorphism"
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_marginBottom="16dp"
            android:elevation="3dp">

            <!-- Profile Icon -->
            <ImageView
                android:id="@+id/profileIcon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_dashboard_tile"
                android:padding="12dp"
                android:src="@drawable/ic_person"
                android:contentDescription="Profile icon"
                android:tint="@color/jg_gold_light"
                android:layout_marginBottom="16dp" />

            <!-- User Name -->
            <TextView
                android:id="@+id/userNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="John Doe"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:textColor="@color/jg_gold_light"
                android:gravity="center"
                android:layout_marginBottom="4dp" />

            <!-- User Email -->
            <TextView
                android:id="@+id/userEmailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="john.doe@example.com"
                android:textColor="@color/jg_text_secondary"
                android:gravity="center"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/lastSyncText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Last sync: Not synced yet"
                android:textColor="@color/jg_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Statistics Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Statistics"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/jg_gold_light"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Statistics Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <!-- Total Gradings -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_glassmorphism"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Gradings"
                    android:textColor="@color/jg_gold"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/totalGradingsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                    android:textColor="@color/jg_gold_light"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Average Score -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_glassmorphism"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Avg Score"
                    android:textColor="@color/jg_gold"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/averageScoreValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="88.5"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                    android:textColor="@color/jg_gold_light"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Preferred Gold Karat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glassmorphism"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preferred Karat"
                android:textColor="@color/jg_gold"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/favoriteGemstoneValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18K"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                android:textColor="@color/jg_gold_light"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Settings Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings &amp; More"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/jg_gold_light"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Settings Button -->
        <LinearLayout
            android:id="@+id/settingsButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_glassmorphism"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚙ Settings &amp; Preferences"
                android:textColor="@color/jg_text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/jg_gold"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- About Button -->
        <LinearLayout
            android:id="@+id/aboutButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_glassmorphism"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ℹ About JewelGrade"
                android:textColor="@color/jg_text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/jg_gold"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- Admin: Review Feedback -->
        <LinearLayout
            android:id="@+id/feedbackAdminButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_glassmorphism"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Review Feedback (admin)"
                android:textColor="@color/jg_text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/jg_gold"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- Logout Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/logoutButton"
            style="@style/JewelGrade.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</ScrollView>
