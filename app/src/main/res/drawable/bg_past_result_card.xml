<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000033" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Main card -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/jg_black_card" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="@color/jg_gold_dark" />
        </shape>
    </item>
</layer-list>
